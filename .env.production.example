BAG_ENVIRONMENT=production
BAG_PUBLIC_MCP_URL=https://mcp.example.com/mcp

BAG_OAUTH_ENABLED=true
BAG_OAUTH_ISSUER=https://id.example.com/realms/business-ai
BAG_OAUTH_AUDIENCE=https://mcp.example.com/mcp
BAG_OAUTH_REQUIRED_SCOPE=onec:read
BAG_OAUTH_JWKS_URL=https://id.example.com/realms/business-ai/protocol/openid-connect/certs
BAG_OAUTH_ALGORITHMS=RS256

# Admin Control Center is disabled until an initial platform role binding is bootstrapped.
# When enabled it MUST use a distinct OAuth audience/scope from BAG_OAUTH_AUDIENCE.
BAG_ADMIN_API_ENABLED=false
BAG_ADMIN_OAUTH_AUDIENCE=https://mcp.example.com/admin
BAG_ADMIN_OAUTH_REQUIRED_SCOPE=erp_mcp:admin

BAG_DATABASE_URL=postgresql://business_ai_app:CHANGE_ME@postgres:5432/business_ai
BAG_ADMIN_DATABASE_URL=postgresql://business_ai_admin:CHANGE_ME@postgres:5432/business_ai
BAG_MIGRATION_DATABASE_URL=postgresql://business_ai_owner:CHANGE_ME@postgres:5432/business_ai
BAG_REDIS_URL=redis://redis:6379/0

BAG_SECRET_PROVIDER=file
BAG_SECRET_FILE_ROOT=/run/secrets

BAG_MAX_ROWS=200
BAG_MAX_RESPONSE_BYTES=5000000
BAG_HTTP_TIMEOUT_SECONDS=30
BAG_MAX_FILTER_CHARS=4000
BAG_REQUIRE_METADATA_ENTITY=true
BAG_RATE_LIMIT_PER_MINUTE=120
BAG_AUDIT_INCLUDE_QUERY=false

# Deploy the pinned read-only OData sidecar on a private network. The internal
# hop must use TLS in production. Keep host[:port] allowlist synchronized with
# registered 1C endpoints; never use '*'.
BAG_ODATA_SIDECAR_URL=https://odata-sidecar.internal.example
BAG_ODATA_SIDECAR_TOKEN=INJECT_FROM_SECRET_MANAGER_MINIMUM_32_RANDOM_BYTES
ONEC_ALLOWED_HOSTS=onec.internal.example
