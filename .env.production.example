BAG_ENVIRONMENT=production
BAG_PUBLIC_MCP_URL=https://mcp.example.com/mcp

BAG_OAUTH_ENABLED=true
BAG_OAUTH_ISSUER=https://id.example.com/realms/business-ai
BAG_OAUTH_AUDIENCE=https://mcp.example.com/mcp
BAG_OAUTH_REQUIRED_SCOPE=onec:read
BAG_OAUTH_JWKS_URL=https://id.example.com/realms/business-ai/protocol/openid-connect/certs
BAG_OAUTH_ALGORITHMS=RS256

# Admin Control Center is disabled until an initial platform role binding is bootstrapped.
# When enabled it MUST use a distinct OAuth audience/scope from BAG_OAUTH_AUDIENCE.
BAG_ADMIN_API_ENABLED=false
BAG_ADMIN_MUTATIONS_ENABLED=false
BAG_ADMIN_UI_ENABLED=false
BAG_ADMIN_OAUTH_AUDIENCE=https://mcp.example.com/admin
BAG_ADMIN_OAUTH_REQUIRED_SCOPE=erp_mcp:admin
BAG_ADMIN_OIDC_AUTHORIZATION_URL=https://id.example.com/realms/business-ai/protocol/openid-connect/auth
BAG_ADMIN_OIDC_TOKEN_URL=https://id.example.com/realms/business-ai/protocol/openid-connect/token
BAG_ADMIN_OIDC_CLIENT_ID=erp-mcp-admin
BAG_ADMIN_OIDC_REDIRECT_URI=https://mcp.example.com/admin/callback
# Optional confidential-client secret, injected from a secret store if used by the IdP.
# BAG_ADMIN_OIDC_CLIENT_SECRET=INJECT_FROM_SECRET_MANAGER
BAG_ADMIN_SESSION_TTL_SECONDS=28800
BAG_ADMIN_STEP_UP_ACR_VALUES=urn:mfa,urn:phishing-resistant
BAG_ADMIN_CONTROL_DATABASE_URL=postgresql://business_ai_control_api:CHANGE_ME@postgres:5432/business_ai
BAG_ADMIN_SOURCE_ALLOWED_HOSTS=onec.internal.example
BAG_ADMIN_SOURCE_ALLOWED_CIDRS=10.0.0.0/8
BAG_BUSINESS_CAPABILITY_ENFORCEMENT_ENABLED=false

BAG_DATABASE_URL=postgresql://business_ai_app:CHANGE_ME@postgres:5432/business_ai
BAG_ADMIN_DATABASE_URL=postgresql://business_ai_admin:CHANGE_ME@postgres:5432/business_ai
BAG_MIGRATION_DATABASE_URL=postgresql://business_ai_owner:CHANGE_ME@postgres:5432/business_ai
BAG_REDIS_URL=redis://redis:6379/0

# Exact hostnames only; source endpoints outside this list are denied. Keep in
# sync with ONEC_ALLOWED_HOSTS on the isolated OData sidecar. This is not a
# substitute for connect-time DNS validation and deployment egress controls.
BAG_SOURCE_HOST_ALLOWLIST=onec.internal.example
BAG_SOURCE_EGRESS_CIDRS=10.0.0.0/8,192.168.0.0/16
BAG_SIDECAR_EGRESS_CIDRS=10.0.0.0/8

BAG_SECRET_PROVIDER=file
BAG_SECRET_FILE_ROOT=/run/secrets

# If the isolated Windows RSV service is configured, set this to the independently
# approved bridge executable SHA-256. A source commit pin does not prove binary parity.
# BAG_RSV_BRIDGE_EXECUTABLE_SHA256=APPROVED_64_HEX_SHA256
# BAG_RSV_BRIDGE_CONFIG_SECRET_REF=rsv-bridge-config-json

BAG_MAX_ROWS=200
BAG_MAX_RESPONSE_BYTES=5000000
BAG_HTTP_TIMEOUT_SECONDS=30
BAG_MAX_FILTER_CHARS=4000
BAG_REQUIRE_METADATA_ENTITY=true
BAG_RATE_LIMIT_PER_MINUTE=120
BAG_AUDIT_INCLUDE_QUERY=false

# Disabled until private volume identity/retention/DR policy and approval index are approved.
# Configure all three together, protected private files outside Git; no public upload route.
# BAG_EVIDENCE_STORE_ROOT=/private/erp-mcp-evidence-owned
# BAG_EVIDENCE_APPROVAL_INDEX=/private/erp-mcp-evidence-owned/approval.json
# BAG_EVIDENCE_APPROVAL_SHA256=<operator-approved-64-lowercase-hex-digest>

# Optional aggregate HTTP metrics scrape. Inject a random >=32-byte token from
# the secret manager only when a protected internal scraper is configured.
BAG_METRICS_TOKEN=INJECT_FROM_SECRET_MANAGER_MINIMUM_32_RANDOM_BYTES

# Deploy the pinned read-only OData sidecar on a private network. The internal
# hop must use TLS in production. Keep host[:port] allowlist synchronized with
# registered 1C endpoints; never use '*'.
BAG_ODATA_SIDECAR_URL=https://odata-sidecar.internal.example
BAG_ODATA_SIDECAR_TOKEN=INJECT_FROM_SECRET_MANAGER_MINIMUM_32_RANDOM_BYTES
ONEC_ALLOWED_HOSTS=onec.internal.example
