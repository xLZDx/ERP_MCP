BAG_ENVIRONMENT=development
BAG_OAUTH_ENABLED=false
BAG_DATABASE_URL=postgresql://business_ai:business_ai@localhost:5432/business_ai
BAG_REDIS_URL=redis://localhost:6379/0
BAG_SECRET_PROVIDER=env
BAG_MAX_ROWS=50
BAG_MAX_RESPONSE_BYTES=1000000
BAG_REQUIRE_METADATA_ENTITY=true

# Optional local-only metrics scrape token; omit to keep /metrics disabled.
# BAG_METRICS_TOKEN=replace-with-at-least-32-random-bytes

# Optional pinned OData sidecar. Use a generated random token (>=32 bytes) and
# list only the exact 1C authority host[:port] values, comma-separated.
BAG_ODATA_SIDECAR_URL=http://odata-sidecar:8765
BAG_ODATA_SIDECAR_TOKEN=replace-with-at-least-32-random-bytes
ONEC_ALLOWED_HOSTS=onec-demo.example.test

ONEC_DEMO_USERNAME=readonly-user
ONEC_DEMO_PASSWORD=change-me
