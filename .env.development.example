BAG_ENVIRONMENT=development
BAG_OAUTH_ENABLED=false
BAG_ADMIN_API_ENABLED=false
BAG_ADMIN_MUTATIONS_ENABLED=false
BAG_ADMIN_UI_ENABLED=false
# When enabled, use a distinct admin audience/scope from the MCP data plane.
BAG_ADMIN_OAUTH_AUDIENCE=http://127.0.0.1:8000/admin
BAG_ADMIN_OAUTH_REQUIRED_SCOPE=erp_mcp:admin
BAG_ADMIN_OIDC_AUTHORIZATION_URL=http://127.0.0.1:8080/authorize
BAG_ADMIN_OIDC_TOKEN_URL=http://127.0.0.1:8080/token
BAG_ADMIN_OIDC_CLIENT_ID=erp-mcp-admin
BAG_ADMIN_OIDC_REDIRECT_URI=http://127.0.0.1:8000/admin/callback
BAG_ADMIN_STEP_UP_ACR_VALUES=urn:mfa,urn:phishing-resistant
# Use a dedicated business_ai_control_api DSN before enabling mutations.
# BAG_ADMIN_CONTROL_DATABASE_URL=postgresql://business_ai_control_api:CHANGE_ME@localhost:5432/business_ai
BAG_ADMIN_SOURCE_ALLOWED_HOSTS=onec-demo.example.test
BAG_ADMIN_SOURCE_ALLOWED_CIDRS=
BAG_BUSINESS_CAPABILITY_ENFORCEMENT_ENABLED=false
BAG_DATABASE_URL=postgresql://business_ai:business_ai@localhost:5432/business_ai
BAG_REDIS_URL=redis://localhost:6379/0
BAG_SECRET_PROVIDER=env
BAG_MAX_ROWS=50
BAG_MAX_RESPONSE_BYTES=1000000
BAG_REQUIRE_METADATA_ENTITY=true

# Optional local-only metrics scrape token; omit to keep /metrics disabled.
# BAG_METRICS_TOKEN=replace-with-at-least-32-random-bytes

# Optional pinned OData sidecar. Use a generated random token (>=32 bytes) and
# list only the exact 1C authority host[:port] values, comma-separated.
BAG_ODATA_SIDECAR_URL=http://odata-sidecar:8765
BAG_ODATA_SIDECAR_TOKEN=replace-with-at-least-32-random-bytes
ONEC_ALLOWED_HOSTS=onec-demo.example.test

ONEC_DEMO_USERNAME=readonly-user
ONEC_DEMO_PASSWORD=change-me
